{
  "name": "my-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens:build": "node scripts/generate-color-tokens.mjs",
    "docs:manifest": "node scripts/generate-component-manifest.mjs",
    "dev": "npm run tokens:build && vite",
    "build": "npm run tokens:build && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest --project unit run",
    "test:storybook": "vitest --project storybook run",
    "preview": "vite preview",
    "storybook": "npm run tokens:build && storybook dev -p 6006",
    "build-storybook": "npm run tokens:build && storybook build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "storybook": "^10.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
